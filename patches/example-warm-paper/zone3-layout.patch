@@ @zone:layout
-/* @zone:layout */
+/* @zone:layout */
+.page {
+  display: grid;
+  grid-template: auto 1fr auto / 240px 1fr 280px;
+  max-width: 100vw;
+  min-height: 100vh;
+}
+
+.left.sidebar {
+  background: #f4efe2;
+  border-right: 1px solid #d4c9b0;
+  padding: 24px 20px;
+  overflow-y: auto;
+}
+
+.center {
+  padding: 48px 40px;
+  max-width: 100%;
+}
+
+.right.sidebar {
+  background: #f4efe2;
+  border-left: 1px solid #d4c9b0;
+  padding: 48px 20px;
+  overflow-y: auto;
+}
