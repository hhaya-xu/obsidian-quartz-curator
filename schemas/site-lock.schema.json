{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hhaya-xu/obsidian-quartz-curator/schemas/site-lock.schema.json",
  "title": "OQC v1.1 site certification lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "oqcVersion",
    "quartzVersion",
    "overlaySha256",
    "installedOverlaySha256",
    "publicConfigSha256",
    "themeSha256",
    "baseUrl",
    "certificationId",
    "visualApprovalRef"
  ],
  "properties": {
    "schemaVersion": { "const": "oqc.site-lock.v1" },
    "oqcVersion": { "type": "string" },
    "quartzVersion": { "type": "string" },
    "overlaySha256": { "$ref": "#/$defs/sha256" },
    "installedOverlaySha256": { "$ref": "#/$defs/sha256" },
    "publicConfigSha256": { "$ref": "#/$defs/sha256" },
    "themeSha256": { "$ref": "#/$defs/sha256" },
    "baseUrl": { "type": "string", "pattern": "^(?!https?://).+" },
    "certificationId": { "type": "string", "minLength": 1 },
    "visualApprovalRef": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
  }
}
